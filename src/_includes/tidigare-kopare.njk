{#-
  Startsidans ruta med omdömen om sålda brädor, se omSalda i lib/omdomen.js.
  Utan sådana omdömen syns ingenting.

  Inget snitt och ingen strukturerad data här, med flit. Rutan blandar
  omdömen om olika brädor, så ett snitt skulle inte gälla någon vara. Och
  betyg som en verksamhet visar om sig själv på sin egen startsida räknar
  Google inte, så det enda det kunde ge vore en varning i Search Console.

  Brädans namn länkar till dess sida, som ligger kvar efter försäljningen
  och visar vad omdömet gäller.
-#}
{%- from "stjarnor.njk" import stjarnor %}
{%- set tidigare = omdomen | omdomenOmSalda(products) %}
{%- if tidigare.length %}
<section class="passage omdomen" id="tidigare-kopare">
  {% include "ornament.njk" %}
  <h2 class="passage__rubrik">FRÅN TIDIGARE KÖPARE</h2>
  <ul class="omdomen__lista">
    {%- for o in tidigare %}
    <li class="omdomen__post">
      {{ stjarnor(o.betyg, 'tidigare' + o.id) }}
      <p class="omdomen__text">{{ o.text }}</p>
      <p class="omdomen__vem">{{ o.namn }}{% if o.ort %}, {{ o.ort }}{% endif %}, {{ o.datum | manad }}. Om <a href="/brada/{{ o.brada.slug }}/">N:o&nbsp;{{ o.brada.nr }}. {{ o.brada.titel }}</a>, som är såld.</p>
    </li>
    {%- endfor %}
  </ul>
  {% include "omdomen-kontroll.njk" %}
</section>
{%- endif %}
